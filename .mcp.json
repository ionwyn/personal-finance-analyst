{
  "mcpServers": {
    "snaptrade": {
      "command": "snaptrade",
      "args": ["mcp"]
    },
    "postgres": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "DATABASE_URI",
        "crystaldba/postgres-mcp",
        "--access-mode=unrestricted"
      ],
      "env": {
        "PG_CONNECTION_STRING": "${DATABASE_URL}"
      }
    },
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"]
    },
    "snaptrade-mcp": {
			"type": "stdio",
			"command": "snaptrade",
			"args": [
				"mcp"
			]
		}
  }
}
