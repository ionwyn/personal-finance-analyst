    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "dev:db": "docker compose up -d postgres",
    "sync:plaid": "tsx scripts/sync-plaid.ts",
    "import:ws-export": "tsx scripts/import-ws-export.ts",
