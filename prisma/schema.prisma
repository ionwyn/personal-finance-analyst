generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TenantKind {
  PERSONAL
  DEMO
}

enum PlaidItemStatus {
  IDLE
  SYNCING
  ERROR
}

enum SyncSource {
  MANUAL
  SCHEDULED
  WEBHOOK
  SEED
}

enum SyncRunStatus {
  RUNNING
  SUCCESS
  ERROR
  SKIPPED
}

enum SnapTradeConnectionStatus {
  IDLE
  SYNCING
  ERROR
  DISABLED
}

enum BrokerLedgerProvider {
  SNAPTRADE
  WEALTHSIMPLE_CSV
}

enum BrokerLedgerSourceStatus {
  PENDING
  LINKED
  CONFLICT
  IGNORED
}

enum BrokerLedgerIngestionMode {
  SYNC
  IMPORT
  MIGRATION
}

enum BrokerLedgerReconciliationStatus {
  UNKNOWN
  COMPLETE
  PARTIAL
  CONFLICT
}

model Tenant {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  kind      TenantKind
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  users                 User[]
  plaidItems            PlaidItem[]
  plaidAccounts         PlaidAccount[]
  transactions          PlaidTransaction[]
  balanceSnapshots      BalanceSnapshot[]
  syncRuns              SyncRun[]
  snapTradeConnections  SnapTradeConnection[]
  snapTradeAccounts     SnapTradeAccount[]
  snapTradePositions    SnapTradePosition[]
  snapTradeCashBalances SnapTradeCashBalance[]
  snapTradeActivities   SnapTradeActivity[]
  snapTradeSyncRuns     SnapTradeSyncRun[]
  brokerLedgerEntries   BrokerLedgerEntry[]
  brokerLedgerSources   BrokerLedgerSourceRecord[]
  brokerLedgerRuns      BrokerLedgerIngestionRun[]
  brokerLedgerCoverage  BrokerLedgerCoverage[]
  performanceSummaries  PortfolioPerformanceSummary[]
  performancePoints     PortfolioPerformancePoint[]
  payCycles             PayCycle[]
  recurringExpenses     RecurringExpense[]
  savingsDestinations   SavingsDestination[]
  settlementPatterns    SettlementPattern[]
  incomeSources         IncomeSource[]
  budgets               Budget[]
  savingsGoals          SavingsGoal[]
  committedSettlements  CommittedSettlement[]
  userSettings          UserSettings?
  watchlistItems        WatchlistItem[]

  @@index([kind])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  tenantId      String?

  tenant     Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  accounts   Account[]
  sessions   Session[]
  plaidItems PlaidItem[]

  @@index([tenantId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PlaidItem {
  id                   String          @id @default(cuid())
  tenantId             String
  createdById          String?
  plaidItemId          String          @unique
  institutionId        String?
  institutionName      String?
  accessTokenEncrypted String          @db.Text
  syncCursor           String?         @db.Text
  status               PlaidItemStatus @default(IDLE)
  lastSyncAt           DateTime?
  lastBalanceRefreshAt DateTime?
  errorCode            String?
  errorMessage         String?         @db.Text
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy    User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  accounts     PlaidAccount[]
  transactions PlaidTransaction[]
  syncRuns     SyncRun[]

  @@index([tenantId])
  @@index([status])
  @@index([createdById])
}

model PlaidAccount {
  id                     String    @id @default(cuid())
  tenantId               String
  itemId                 String
  plaidAccountId         String    @unique
  name                   String
  officialName           String?
  type                   String
  subtype                String?
  mask                   String?
  isoCurrencyCode        String?
  unofficialCurrencyCode String?
  availableBalance       Decimal?  @db.Decimal(18, 2)
  currentBalance         Decimal?  @db.Decimal(18, 2)
  limit                  Decimal?  @db.Decimal(18, 2)
  lastBalanceAt          DateTime?
  // When false the account is "untracked": its transactions are not synced or
  // stored, no balance snapshots are captured, and it is excluded from every
  // total. User-controlled from the account's three-dots menu. Defaults true.
  tracked                Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item             PlaidItem          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  transactions     PlaidTransaction[]
  balanceSnapshots BalanceSnapshot[]

  @@index([tenantId])
  @@index([itemId])
  @@index([type, subtype])
}

model PlaidTransaction {
  id                     String    @id @default(cuid())
  tenantId               String
  itemId                 String
  accountId              String
  plaidTransactionId     String    @unique
  pendingTransactionId   String?
  name                   String
  merchantName           String?
  amount                 Decimal   @db.Decimal(18, 2)
  isoCurrencyCode        String?
  unofficialCurrencyCode String?
  date                   DateTime
  authorizedDate         DateTime?
  datetime               DateTime?
  authorizedDatetime     DateTime?
  paymentChannel         String?
  categoryPrimary        String?
  categoryDetailed       String?
  categoryConfidence     String?
  pending                Boolean   @default(false)
  removed                Boolean   @default(false)
  raw                    Json
  cycleId                String?
  txnType                String    @default("expense")
  source                 String    @default("plaid")
  supersededById         String?   @unique
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item         PlaidItem             @relation(fields: [itemId], references: [id], onDelete: Cascade)
  account      PlaidAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cycle        PayCycle?             @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  supersededBy PlaidTransaction?     @relation("ManualSweepSupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   PlaidTransaction?     @relation("ManualSweepSupersession")
  settlements  CommittedSettlement[]

  @@index([tenantId, date])
  @@index([accountId, date])
  @@index([itemId])
  @@index([removed])
  @@index([merchantName])
  @@index([categoryPrimary])
  @@index([tenantId, cycleId])
  @@index([tenantId, txnType, date])
}

model BalanceSnapshot {
  id                     String   @id @default(cuid())
  tenantId               String
  accountId              String
  availableBalance       Decimal? @db.Decimal(18, 2)
  currentBalance         Decimal? @db.Decimal(18, 2)
  limit                  Decimal? @db.Decimal(18, 2)
  isoCurrencyCode        String?
  unofficialCurrencyCode String?
  capturedAt             DateTime @default(now())
  raw                    Json

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account PlaidAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([tenantId, capturedAt])
  @@index([accountId, capturedAt])
}

model SyncRun {
  id             String        @id @default(cuid())
  tenantId       String
  itemId         String?
  source         SyncSource
  status         SyncRunStatus @default(RUNNING)
  startedAt      DateTime      @default(now())
  completedAt    DateTime?
  addedCount     Int           @default(0)
  modifiedCount  Int           @default(0)
  removedCount   Int           @default(0)
  accountsCount  Int           @default(0)
  errorCode      String?
  errorMessage   String?       @db.Text
  plaidRequestId String?

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item   PlaidItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([tenantId, startedAt])
  @@index([itemId, status])
  @@index([source])
}

model SnapTradeConnection {
  id                       String                    @id @default(cuid())
  tenantId                 String
  snapTradeAuthorizationId String                    @unique
  name                     String?
  type                     String?
  brokerageName            String?
  brokerageSlug            String?
  disabled                 Boolean                   @default(false)
  disabledAt               DateTime?
  status                   SnapTradeConnectionStatus @default(IDLE)
  lastSyncAt               DateTime?
  lastManualRefreshAt      DateTime?
  errorCode                String?
  errorMessage             String?                   @db.Text
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accounts SnapTradeAccount[]
  syncRuns SnapTradeSyncRun[]

  @@index([tenantId])
  @@index([status])
  @@index([disabled])
}

model SnapTradeAccount {
  id                          String    @id @default(cuid())
  tenantId                    String
  connectionId                String
  snapTradeAccountId          String    @unique
  name                        String
  institutionName             String?
  rawType                     String?
  accountCategory             String?
  // SnapTrade meta.unified_account_type, e.g. CREDIT_CARD,
  // SELF_DIRECTED_NON_REGISTERED_MARGIN, CASH. This is the only field that
  // reliably distinguishes credit cards / margin / cash from one another —
  // rawType collapses both margin and plain non-registered to "PERSONAL".
  unifiedAccountType          String?
  currency                    String?
  totalValue                  Decimal?  @db.Decimal(24, 8)
  openedAt                    DateTime?
  snapTradeCreatedAt          DateTime?
  status                      String?
  isPaper                     Boolean   @default(false)
  // When false the account is "untracked": it is not synced (no positions,
  // balances, or activities fetched) and is excluded from every investment
  // total. User-controlled from the account's three-dots menu. Defaults true.
  tracked                     Boolean   @default(true)
  lastHoldingsSyncAt          DateTime?
  holdingsInitialSyncComplete Boolean   @default(false)
  activitiesBackfilledAt      DateTime?
  lastActivityDate            DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  tenant         Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection     SnapTradeConnection        @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  positions      SnapTradePosition[]
  balances       SnapTradeCashBalance[]
  activities     SnapTradeActivity[]
  ledgerEntries  BrokerLedgerEntry[]
  ledgerSources  BrokerLedgerSourceRecord[]
  ledgerCoverage BrokerLedgerCoverage?

  @@index([tenantId])
  @@index([connectionId])
  @@index([accountCategory])
}

model SnapTradePosition {
  id                String   @id @default(cuid())
  tenantId          String
  accountId         String
  snapTradeSymbolId String?
  symbol            String
  rawSymbol         String?
  description       String?
  assetType         String
  exchange          String?
  currency          String
  units             Decimal  @db.Decimal(24, 8)
  price             Decimal? @db.Decimal(24, 8)
  avgCost           Decimal? @db.Decimal(24, 8)
  marketValueNative Decimal  @db.Decimal(24, 8)
  marketValueCad    Decimal  @db.Decimal(24, 8)
  costNative        Decimal? @db.Decimal(24, 8)
  costCad           Decimal? @db.Decimal(24, 8)
  pnlCad            Decimal? @db.Decimal(24, 8)
  pnlPct            Decimal? @db.Decimal(18, 8)
  cashEquivalent    Boolean  @default(false)
  logoId            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account SnapTradeAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  logo    SnapTradeSecurityLogo? @relation(fields: [logoId], references: [id], onDelete: SetNull)

  @@unique([accountId, symbol, currency])
  @@index([tenantId])
  @@index([accountId])
  @@index([accountId, marketValueCad(sort: Desc)])
  @@index([symbol])
  @@index([assetType])
}

model SnapTradeCashBalance {
  id          String   @id @default(cuid())
  tenantId    String
  accountId   String
  currency    String
  cash        Decimal  @db.Decimal(24, 8)
  buyingPower Decimal? @db.Decimal(24, 8)
  cashCad     Decimal  @db.Decimal(24, 8)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account SnapTradeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, currency])
  @@index([tenantId])
}

model SnapTradeActivity {
  id                  String    @id @default(cuid())
  tenantId            String
  accountId           String
  snapTradeActivityId String    @unique
  type                String
  symbol              String?
  description         String?   @db.Text
  units               Decimal?  @db.Decimal(24, 8)
  price               Decimal?  @db.Decimal(24, 8)
  amount              Decimal?  @db.Decimal(24, 8)
  fee                 Decimal?  @db.Decimal(24, 8)
  currency            String
  fxRate              Decimal?  @db.Decimal(18, 8)
  tradeDate           DateTime?
  settlementDate      DateTime?
  externalReferenceId String?
  institution         String?
  raw                 Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account SnapTradeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([tenantId, tradeDate])
  @@index([accountId, tradeDate])
  @@index([symbol])
  @@index([type])
  @@index([externalReferenceId])
}

model BrokerLedgerEntry {
  id                String    @id @default(cuid())
  tenantId          String
  accountId         String?
  accountExternalId String
  accountType       String
  tradeDate         DateTime  @db.Date
  settlementDate    DateTime? @db.Date
  activityType      String
  activitySubType   String?
  symbol            String?
  symbolNorm        String?
  name              String?   @db.Text
  currency          String?
  // Signed source quantity: buys/inbound transfers are positive; sells/outbound are negative.
  units             Decimal   @db.Decimal(24, 8)
  // Wealthsimple export prices are already expressed in CAD.
  unitPrice         Decimal?  @db.Decimal(24, 10)
  // App convention in CAD: positive is a debit/outflow; negative is a credit/inflow.
  cashAmount        Decimal?  @db.Decimal(24, 10)
  nativeCashAmount  Decimal?  @db.Decimal(24, 10)
  nativeCurrency    String?
  fxRate            Decimal?  @db.Decimal(24, 10)
  dedupeKey         String    @unique
  raw               Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant        Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account       SnapTradeAccount?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  sourceRecords BrokerLedgerSourceRecord[]

  @@index([tenantId, tradeDate])
  @@index([tenantId, tradeDate(sort: Desc), createdAt(sort: Desc)])
  @@index([tenantId, activityType, tradeDate])
  @@index([tenantId, symbolNorm])
  @@index([tenantId, symbolNorm, tradeDate(sort: Desc), createdAt(sort: Desc)])
  @@index([accountId, tradeDate])
}

model BrokerLedgerIngestionRun {
  id                 String                    @id @default(cuid())
  tenantId           String
  provider           BrokerLedgerProvider
  mode               BrokerLedgerIngestionMode
  status             SyncRunStatus             @default(RUNNING)
  startedAt          DateTime                  @default(now())
  completedAt        DateTime?
  sourceCount        Int                       @default(0)
  insertedCount      Int                       @default(0)
  linkedCount        Int                       @default(0)
  canonicalizedCount Int                       @default(0)
  ignoredCount       Int                       @default(0)
  conflictCount      Int                       @default(0)
  errorMessage       String?                   @db.Text

  tenant        Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceRecords BrokerLedgerSourceRecord[]

  @@index([tenantId, startedAt])
  @@index([provider, status])
}

model BrokerLedgerSourceRecord {
  id               String                   @id @default(cuid())
  tenantId         String
  accountId        String?
  ledgerEntryId    String?
  ingestionRunId   String?
  provider         BrokerLedgerProvider
  sourceKey        String
  providerRecordId String?
  status           BrokerLedgerSourceStatus @default(PENDING)
  matchConfidence  Decimal?                 @db.Decimal(5, 4)
  conflictReason   String?                  @db.Text
  tradeDate        DateTime?                @db.Date
  settlementDate   DateTime?                @db.Date
  activityType     String?
  activitySubType  String?
  symbol           String?
  symbolNorm       String?
  name             String?                  @db.Text
  currency         String?
  units            Decimal?                 @db.Decimal(24, 8)
  unitPrice        Decimal?                 @db.Decimal(24, 10)
  nativeCashAmount Decimal?                 @db.Decimal(24, 10)
  nativeCurrency   String?
  cashAmount       Decimal?                 @db.Decimal(24, 10)
  fxRate           Decimal?                 @db.Decimal(24, 10)
  raw              Json?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  tenant       Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account      SnapTradeAccount?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  ledgerEntry  BrokerLedgerEntry?        @relation(fields: [ledgerEntryId], references: [id], onDelete: SetNull)
  ingestionRun BrokerLedgerIngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([tenantId, provider, sourceKey])
  @@index([tenantId, status])
  @@index([accountId, tradeDate])
  @@index([ledgerEntryId])
  @@index([ingestionRunId])
  @@index([provider, providerRecordId])
  @@index([ledgerEntryId, provider, sourceKey])
}

model BrokerLedgerCoverage {
  id                   String                           @id @default(cuid())
  tenantId             String
  accountId            String                           @unique
  activityStartDate    DateTime?                        @db.Date
  activityEndDate      DateTime?                        @db.Date
  taxCoverageStartDate DateTime?                        @db.Date
  reconciliationStatus BrokerLedgerReconciliationStatus @default(UNKNOWN)
  canonicalizedAt      DateTime?
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account SnapTradeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([tenantId, reconciliationStatus])
}

model PortfolioPerformanceSummary {
  id                         String   @id @default(cuid())
  tenantId                   String
  asOf                       DateTime @db.Date
  inceptionDate              DateTime? @db.Date
  terminalDate               DateTime? @db.Date
  terminalValueCad           Decimal? @db.Decimal(24, 10)
  terminalSecuritiesValueCad Decimal? @db.Decimal(24, 10)
  terminalCashCad            Decimal? @db.Decimal(24, 10)
  syncedValueCad             Decimal  @db.Decimal(24, 10)
  syncedSecuritiesValueCad   Decimal  @db.Decimal(24, 10)
  syncedCashCad              Decimal  @db.Decimal(24, 10)
  terminalDifferenceCad      Decimal? @db.Decimal(24, 10)
  terminalDifferencePct      Decimal? @db.Decimal(18, 10)
  cashDifferenceCad          Decimal? @db.Decimal(24, 10)
  terminalReconciled         Boolean
  resolvedSymbols            Int
  lifetimeSymbols            Int
  fxSource                   String
  twr3M                      Decimal? @db.Decimal(18, 10)
  twr6M                      Decimal? @db.Decimal(18, 10)
  twr1Y                      Decimal? @db.Decimal(18, 10)
  twrAll                     Decimal? @db.Decimal(18, 10)
  mwr                        Decimal? @db.Decimal(18, 10)
  coverageIssues             Json
  generatedAt                DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  tenant Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  points PortfolioPerformancePoint[]

  @@unique([tenantId, asOf])
  @@index([tenantId, generatedAt])
}

model PortfolioPerformancePoint {
  id                 String   @id @default(cuid())
  tenantId           String
  summaryId          String
  date               DateTime @db.Date
  portfolio          Decimal  @db.Decimal(24, 10)
  spx                Decimal? @db.Decimal(24, 10)
  tsx                Decimal? @db.Decimal(24, 10)
  valueCad           Decimal? @db.Decimal(24, 10)
  securitiesValueCad Decimal? @db.Decimal(24, 10)
  cashCad            Decimal? @db.Decimal(24, 10)

  tenant  Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  summary PortfolioPerformanceSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)

  @@unique([summaryId, date])
  @@index([tenantId, date])
}

model SnapTradeSyncRun {
  id                    String        @id @default(cuid())
  tenantId              String
  connectionId          String?
  source                SyncSource
  status                SyncRunStatus @default(RUNNING)
  startedAt             DateTime      @default(now())
  completedAt           DateTime?
  connectionsCount      Int           @default(0)
  accountsCount         Int           @default(0)
  positionsCount        Int           @default(0)
  balancesCount         Int           @default(0)
  activitiesCount       Int           @default(0)
  canonicalizedCount    Int           @default(0)
  ledgerLinkedCount     Int           @default(0)
  ledgerIgnoredCount    Int           @default(0)
  ledgerConflictCount   Int           @default(0)
  omittedPositionsCount Int           @default(0)
  errorCode             String?
  errorMessage          String?       @db.Text

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection SnapTradeConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([tenantId, startedAt])
  @@index([connectionId, status])
  @@index([source])
}

// Provider-neutral FX rate cache (rates sourced from Twelve Data). Formerly
// SnapTradeFxRate — renamed in 20260526160000 when FX moved off SnapTrade.
model FxRate {
  id             String   @id @default(cuid())
  pair           String   @unique
  sourceCurrency String
  targetCurrency String
  rate           Decimal  @db.Decimal(24, 10)
  fetchedAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([sourceCurrency, targetCurrency])
  @@index([fetchedAt])
}

model SnapTradeSecurityLogo {
  id           String    @id
  sourceUrl    String    @db.Text
  status       String    @default("PENDING")
  contentType  String?
  data         Bytes?
  errorMessage String?   @db.Text
  fetchedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  positions SnapTradePosition[]

  @@index([status])
}

model PayCycle {
  id                    String    @id @default(cuid())
  tenantId              String
  startDate             DateTime
  endDate               DateTime
  incomeReceived        Decimal?  @db.Decimal(18, 2)
  fixedSavingsPull      Decimal?  @db.Decimal(18, 2)
  sweptAmount           Decimal?  @db.Decimal(18, 2)
  carryover             Decimal?  @db.Decimal(18, 2)
  creditCardPaymentDate DateTime?
  notes                 String?
  closedAt              DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions PlaidTransaction[]
  settlements  CommittedSettlement[]

  @@unique([tenantId, startDate])
  @@index([tenantId, startDate, endDate])
}

model RecurringExpense {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  merchantPattern String?
  amount          Decimal   @db.Decimal(18, 2)
  frequency       String
  anchorDate      Int?
  accrualPerCycle Decimal   @db.Decimal(18, 2)
  confirmed       Boolean   @default(false)
  active          Boolean   @default(true)
  dismissedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  settlements CommittedSettlement[]

  @@index([tenantId, active])
}

// A per-cycle record that a RecurringExpense has been settled. Persists what the
// derived status alone cannot: "this expense was paid this cycle." A linked
// transactionId means a real charge covered it; null means the user manually
// asserted payment (cash, cheque, or an out-of-system method). Either way the
// expense stops accruing for the cycle. One settlement per expense per cycle.
model CommittedSettlement {
  id                 String   @id @default(cuid())
  tenantId           String
  recurringExpenseId String
  cycleId            String
  transactionId      String?
  method             String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recurringExpense RecurringExpense  @relation(fields: [recurringExpenseId], references: [id], onDelete: Cascade)
  cycle            PayCycle          @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  transaction      PlaidTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([recurringExpenseId, cycleId])
  @@index([tenantId, cycleId])
}

model SavingsDestination {
  id           String   @id @default(cuid())
  tenantId     String
  accountName  String
  matchPattern String
  label        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  savingsGoals SavingsGoal[]

  @@index([tenantId, active])
}

model SettlementPattern {
  id           String   @id @default(cuid())
  tenantId     String
  label        String
  matchPattern String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
}

// A labelled merchant pattern whose matching credits are classified as income.
// Replaces the single UserSettings.employerMerchantPattern with a 1:N model so a
// tenant can track several paychecks/income streams. Matched credits become
// txnType=income and flow into PayCycle.incomeReceived + spending-insight totals.
model IncomeSource {
  id           String   @id @default(cuid())
  tenantId     String
  label        String
  matchPattern String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
}

// A per-category monthly spending cap. categoryPrimary is a Plaid primary
// category (e.g. FOOD_AND_DRINK); spend is compared against month-to-date
// "real spending" for that category. One budget per category per tenant.
model Budget {
  id              String   @id @default(cuid())
  tenantId        String
  categoryPrimary String
  amount          Decimal  @db.Decimal(18, 2)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, categoryPrimary])
  @@index([tenantId, active])
}

// A savings target. When linked to a SavingsDestination, progress is computed
// from savings-classified transactions matching that destination's pattern.
model SavingsGoal {
  id                   String    @id @default(cuid())
  tenantId             String
  name                 String
  targetAmount         Decimal   @db.Decimal(18, 2)
  startDate            DateTime?
  targetDate           DateTime?
  savingsDestinationId String?
  active               Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  savingsDestination SavingsDestination? @relation(fields: [savingsDestinationId], references: [id], onDelete: SetNull)

  @@index([tenantId, active])
  @@index([savingsDestinationId])
}

model UserSettings {
  id                      String    @id @default(cuid())
  tenantId                String    @unique
  payFrequencyDays        Int       @default(14)
  lastPaycheckDate        DateTime?
  employerMerchantPattern String?
  defaultFixedSavings     Decimal?  @db.Decimal(18, 2)
  sweepBuffer             Decimal   @default(100) @db.Decimal(18, 2)
  ccPaymentDayOfMonth     Int?
  defaultLanding          String    @default("dashboard")
  budgetWarnPct           Int       @default(85)
  budgetAlarmPct          Int       @default(100)
  budgetRollForward       Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ─── Market data cache (provider-neutral) ─────────────────────────────────
// Populated by MarketDataService on first position-page load, refreshed on a
// staleness TTL. The provider field records which API sourced the row so stale
// rows can be selectively re-fetched if a provider is swapped.

model MarketQuote {
  symbol    String   @id
  provider  String   @default("yahoo")
  currency  String?
  price     Decimal? @db.Decimal(18, 6)
  change    Decimal? @db.Decimal(18, 6)
  changePct Decimal? @db.Decimal(10, 6)
  open      Decimal? @db.Decimal(18, 6)
  high52w   Decimal? @db.Decimal(18, 6)
  low52w    Decimal? @db.Decimal(18, 6)
  volume    BigInt?
  marketCap Decimal? @db.Decimal(24, 2)
  prevClose Decimal? @db.Decimal(18, 6)
  dayHigh   Decimal? @db.Decimal(18, 6)
  dayLow    Decimal? @db.Decimal(18, 6)
  avgVolume BigInt?
  fetchedAt DateTime
  updatedAt DateTime @updatedAt
}

model MarketProfile {
  symbol                String    @id
  provider              String    @default("yahoo")
  name                  String?
  sector                String?
  industry              String?
  country               String?
  description           String?   @db.Text
  isFund                Boolean   @default(false)
  peRatio               Decimal?  @db.Decimal(10, 4)
  forwardPe             Decimal?  @db.Decimal(10, 4)
  pbRatio               Decimal?  @db.Decimal(10, 4)
  evEbitda              Decimal?  @db.Decimal(10, 4)
  revenueGrowthPct      Decimal?  @db.Decimal(10, 4)
  epsGrowthPct          Decimal?  @db.Decimal(10, 4)
  grossMarginPct        Decimal?  @db.Decimal(10, 4)
  operatingMarginPct    Decimal?  @db.Decimal(10, 4)
  freeCashFlow          Decimal?  @db.Decimal(24, 2)
  dividendYieldPct      Decimal?  @db.Decimal(10, 4)
  expenseRatioPct       Decimal?  @db.Decimal(10, 4)
  aum                   Decimal?  @db.Decimal(24, 2)
  holdingsCount         Int?
  beta                  Decimal?  @db.Decimal(10, 4)
  fetchedAt             DateTime
  profileFetchedAt      DateTime?
  fundamentalsFetchedAt DateTime?
  updatedAt             DateTime  @updatedAt
}

model MarketPriceDay {
  id        String   @id @default(cuid())
  symbol    String
  provider  String   @default("yahoo")
  date      String // YYYY-MM-DD — stored as string to avoid timezone drift
  close     Decimal  @db.Decimal(18, 6)
  open      Decimal? @db.Decimal(18, 6)
  high      Decimal? @db.Decimal(18, 6)
  low       Decimal? @db.Decimal(18, 6)
  volume    BigInt?
  fetchedAt DateTime @default(now())

  @@unique([symbol, date])
  @@index([symbol, date(sort: Desc)])
}

model MarketNews {
  id          String    @id @default(cuid())
  symbol      String
  provider    String    @default("yahoo")
  title       String
  source      String?
  url         String?   @db.Text
  summary     String?   @db.Text
  tag         String? // derived category: DIVIDEND, ANALYST, EARNINGS, ...
  relevance   String? // high | med | low (relatedTickers-based)
  publishedAt DateTime?
  fetchedAt   DateTime  @default(now())

  @@index([symbol, publishedAt(sort: Desc)])
  @@index([symbol, fetchedAt(sort: Desc)])
}

model MarketEvents {
  symbol       String    @id
  provider     String    @default("yahoo")
  nextEarnings DateTime?
  exDividend   DateTime?
  dividendDate DateTime?
  fetchedAt    DateTime
  updatedAt    DateTime  @updatedAt
}

model MarketAnalyst {
  symbol       String   @id
  provider     String   @default("yahoo")
  targetLow    Decimal? @db.Decimal(18, 6)
  targetMean   Decimal? @db.Decimal(18, 6)
  targetHigh   Decimal? @db.Decimal(18, 6)
  analystCount Int?
  recKey       String? // strong_buy | buy | hold | underperform | sell
  recMean      Decimal? @db.Decimal(6, 3) // 1 (strong buy) … 5 (sell)
  strongBuy    Int?
  buy          Int?
  hold         Int?
  sell         Int?
  strongSell   Int?
  fetchedAt    DateTime
  updatedAt    DateTime @updatedAt
}

model MarketDividend {
  id        String   @id @default(cuid())
  symbol    String
  provider  String   @default("yahoo")
  date      String // YYYY-MM-DD ex-date — string to avoid timezone drift
  amount    Decimal  @db.Decimal(18, 8)
  fetchedAt DateTime @default(now())

  @@unique([symbol, date])
  @@index([symbol, date(sort: Desc)])
}

model MacroPoint {
  id        String   @id @default(cuid())
  seriesId  String // FRED series id, e.g. DGS10
  date      String // YYYY-MM-DD
  value     Decimal  @db.Decimal(18, 6)
  fetchedAt DateTime @default(now())

  @@unique([seriesId, date])
  @@index([seriesId, date(sort: Desc)])
}

model WatchlistItem {
  id       String   @id @default(cuid())
  tenantId String
  symbol   String
  name     String?
  exchange String?
  addedAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, symbol])
  @@index([tenantId])
}

// ─── Market intelligence cache (Finnhub / EDGAR / FMP) ────────────────────
// Symbol-level research data beyond quotes: earnings surprises, analyst
// recommendation history, insider transactions, peer lists, SEC filings and
// annual financials. Refreshed on a per-(symbol, kind) TTL via
// MarketIntelFetch, which also records fetches that returned nothing (ETFs,
// non-US listings) so empty results don't refetch on every page view.

model MarketIntelFetch {
  symbol    String
  kind      String // earnings | recs | insiders | peers | filings | financials
  fetchedAt DateTime @default(now())

  @@id([symbol, kind])
}

// Quarterly EPS: actual vs street estimate (Finnhub /stock/earnings).
model MarketEarnings {
  symbol      String
  period      String // fiscal quarter end, YYYY-MM-DD
  provider    String   @default("finnhub")
  quarter     Int?
  year        Int?
  epsActual   Decimal? @db.Decimal(18, 6)
  epsEstimate Decimal? @db.Decimal(18, 6)
  surprisePct Decimal? @db.Decimal(12, 4)
  fetchedAt   DateTime @default(now())

  @@id([symbol, period])
  @@index([symbol, period(sort: Desc)])
}

// Monthly analyst recommendation distribution (Finnhub /stock/recommendation).
model MarketRecTrend {
  symbol     String
  period     String // YYYY-MM-01
  provider   String   @default("finnhub")
  strongBuy  Int      @default(0)
  buy        Int      @default(0)
  hold       Int      @default(0)
  sell       Int      @default(0)
  strongSell Int      @default(0)
  fetchedAt  DateTime @default(now())

  @@id([symbol, period])
  @@index([symbol, period(sort: Desc)])
}

// SEC Form 3/4/5 insider transactions (Finnhub; replace-all per refresh).
model MarketInsiderTx {
  id           String   @id @default(cuid())
  symbol       String
  provider     String   @default("finnhub")
  name         String
  share        BigInt? // shares held after the transaction
  change       BigInt? // signed share delta
  txPrice      Decimal? @db.Decimal(18, 6)
  txCode       String? // SEC transaction code: P, S, M, A, F, G, …
  txDate       String? // YYYY-MM-DD
  filingDate   String? // YYYY-MM-DD
  isDerivative Boolean  @default(false)
  fetchedAt    DateTime @default(now())

  @@index([symbol, txDate(sort: Desc)])
}

// Peer tickers in the same industry (Finnhub /stock/peers).
model MarketPeers {
  symbol    String   @id
  provider  String   @default("finnhub")
  peers     String[]
  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Recent SEC filings (EDGAR submissions feed; replace-all per refresh).
model MarketFiling {
  id        String   @id @default(cuid())
  symbol    String
  provider  String   @default("edgar")
  accession String // accession number, e.g. 0000002488-26-000105
  form      String // 10-K | 10-Q | 8-K | DEF 14A | 4 | …
  filedAt   String // YYYY-MM-DD
  title     String? // primary document description
  url       String   @db.Text
  fetchedAt DateTime @default(now())

  @@unique([symbol, accession])
  @@index([symbol, filedAt(sort: Desc)])
}

// Annual income-statement summary (FMP, last ~5 fiscal years).
model MarketFinancials {
  symbol          String
  fiscalYear      String // e.g. "2025"
  provider        String   @default("fmp")
  endDate         String? // fiscal period end, YYYY-MM-DD
  currency        String?
  revenue         Decimal? @db.Decimal(24, 2)
  grossProfit     Decimal? @db.Decimal(24, 2)
  operatingIncome Decimal? @db.Decimal(24, 2)
  netIncome       Decimal? @db.Decimal(24, 2)
  epsDiluted      Decimal? @db.Decimal(18, 6)
  fetchedAt       DateTime @default(now())

  @@id([symbol, fiscalYear])
  @@index([symbol, fiscalYear(sort: Desc)])
}
