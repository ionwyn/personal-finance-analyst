# DEPLOYMENT_MODE: "private" (default) = owner's real workspace behind GitHub
# OAuth; "demo" = public, sandbox-only build (omit GitHub/Plaid/SnapTrade secrets
# and point DATABASE_URL at the seeded demo database). See DEPLOYMENT.md.
DEPLOYMENT_MODE="private"

# Local dev uses one URL. On Vercel (serverless) DATABASE_URL must be the POOLED
# connection string; run `prisma migrate deploy` with the NON-POOLING URL.
DATABASE_URL="postgresql://finance:finance@localhost:5432/finance?schema=public"
# DIRECT_DATABASE_URL="postgresql://...non-pooling..."  # migrations only
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""
ADMIN_EMAILS="you@example.com"

PLAID_ENV="sandbox"
PLAID_CLIENT_NAME=""
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_WEBHOOK_URL="http://localhost:3000/api/webhooks/plaid"
PLAID_VERIFY_WEBHOOKS="false"

SNAPTRADE_CLIENT_ID=""
SNAPTRADE_CONSUMER_KEY=""
SNAPTRADE_USER_ID=""
SNAPTRADE_USER_SECRET_ENCRYPTED=""
TWELVEDATA_API_KEY=""
FRED_API_KEY=""
FMP_API_KEY=""
ALPHA_VANTAGE_API_KEY=""
# Vala-Fi supply-chain graph (https://valafi.dev). Free tier: 50 req/day,
# 10 unique tickers/day. Optional — the Supply Chain feature degrades to
# cached-only when unset.
VALAFI_API_KEY=""

TOKEN_ENCRYPTION_KEY=""
CRON_SECRET=""
METRICS_TOKEN=""

# Local AI assistant (Ollama). Optional — defaults shown. Inference stays on-device.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b"
# Dual-mode models. Fact mode defaults to llama3.2:3b in dev, qwen2.5:7b in prod.
# Reasoning mode (visible chain-of-thought) defaults to deepseek-r1:7b.
OLLAMA_MODEL_FACT="qwen2.5:7b"
OLLAMA_MODEL_REASONING="deepseek-r1:7b"
